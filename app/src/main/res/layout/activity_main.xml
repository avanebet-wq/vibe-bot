<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Экран установки: одна кнопка -->
    <LinearLayout
        android:id="@+id/install_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Claude Pocket"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Claude Code с полноценным Linux-терминалом прямо на телефоне. Нажми кнопку — приложение само скачает Ubuntu, поставит инструменты и Claude Code. Дальше останется только войти в аккаунт."
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_install"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="Установить всё"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/step_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Нужен интернет, около 1 ГБ свободного места и 5–15 минут. Не закрывай приложение и не блокируй экран."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/details_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Показать подробности"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@color/panel"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>

    <!-- Экран навыков -->
    <LinearLayout
        android:id="@+id/skills_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/panel"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/skills_back"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/text"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Навыки"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Навыки учат Claude новым умениям. Вставь ссылку на репозиторий GitHub с навыком — приложение найдёт в нём файлы SKILL.md и установит."
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/skills_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="https://github.com/автор/репозиторий"
                    android:inputType="textUri"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/skills_install"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="Установить"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/skills_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/skills_create"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Создать навык с помощью Claude →"
                    android:textColor="@color/accent"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="16dp"
                    android:text="УСТАНОВЛЕННЫЕ"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/skills_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Первоначальная настройка: слайды с разрешениями -->
    <LinearLayout
        android:id="@+id/onb_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/onb_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal" />

        <FrameLayout
            android:id="@+id/onb_card"
            android:layout_width="300dp"
            android:layout_height="300dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/onb_emoji"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:contentDescription="@null"
                        android:padding="19dp" />

                    <TextView
                        android:id="@+id/onb_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingBottom="2dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="2dp"
                        android:textColor="@color/on_accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/onb_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/text"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/onb_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/onb_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/onb_primary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:textAllCaps="false"
                        android:textColor="@color/on_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/onb_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- Экран чата -->
    <FrameLayout
        android:id="@+id/chat_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- весь экран чата нарисован на Compose (стекло — библиотека Backdrop) -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/chat_compose"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- невидимые «якоря» для всплывающих меню, которые остались на обычных View -->
        <View
            android:id="@+id/menu_anchor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginRight="14dp"
            android:layout_marginTop="10dp"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/plus_anchor"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="8dp"
            android:layout_marginLeft="10dp"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Страница профиля: квадратная карточка, в центре аватар, вокруг летают пузырьки -->
    <FrameLayout
        android:id="@+id/profile_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/profile_card"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="center"
            android:clickable="true">

            <app.claudepocket.BubblesView
                android:id="@+id/profile_bubbles"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <app.claudepocket.AvatarView
                android:id="@+id/profile_avatar"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:contentDescription="Аватар" />
        </FrameLayout>
    </FrameLayout>

    <!-- Экран входа в аккаунт -->
    <LinearLayout
        android:id="@+id/login_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Вход в Claude"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Установка завершена. Осталось войти в аккаунт Claude (нужна подписка Pro или Max)."
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="1. Открой страницу входа, авторизуйся и скопируй код"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_login_open"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="Готовлю ссылку…"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_login_browser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="6dp"
            android:text="Открыть в браузере"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_login_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="6dp"
            android:text="Скопировать ссылку"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="2. Скопируй код — я вставлю его сам (или вставь вручную)"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/login_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/panel"
            android:hint="Код из браузера"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_login_submit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Войти"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/login_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:padding="10dp"
            android:text="Уже вошёл раньше — пропустить"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
